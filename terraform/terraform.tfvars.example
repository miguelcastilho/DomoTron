# DomoTron Terraform Configuration Example
# ----------------------------------------
# Copy this file to terraform.tfvars and update the values

# Proxmox API Configuration
proxmox_api_url = "https://proxmox.example.com:8006/api2/json"
proxmox_api_token_id = "user@pam!token_name"
proxmox_api_token_secret = "your-proxmox-api-token"

# SSH Public Key for VM/LXC Access
ssh_public_key = "ssh-rsa AAAAB3NzaC1..."

# Network Configuration
network_address = "192.168.1.0/24"
gateway_ip_address = "192.168.1.1"

# Cloudflare Configuration
cloudflare_token = "your-cloudflare-api-token"
cloudflare_zone_id = "your-cloudflare-zone-id"
cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_tunnel_name = "DomoTron Tunnel"

# Tailscale Configuration
tailscale_api_key = "your-tailscale-api-key"
tailscale_tailnet = "example.com"

# AdGuard Home Configuration
adguard_node = "proxmox-node"
adguard_vm_id = 100
adguard_hostname = "adguard"
adguard_storage = "local-lvm"
adguard_storage_size = "8G"
adguard_cores = 2
adguard_memory = 1024
adguard_ip_address = "192.168.1.100"

# Tailscale VM Configuration
tailscale_node = "proxmox-node"
tailscale_vm_id = 101
tailscale_hostname = "tailscale"
tailscale_storage = "local-lvm"
tailscale_storage_size = "8G"
tailscale_cores = 1
tailscale_memory = 512
tailscale_ip_address = "192.168.1.101"

# MediaBox Configuration
mediabox_node = "proxmox-node"
mediabox_vm_id = 102
mediabox_hostname = "mediabox"
mediabox_vm_base_image = "ubuntu-noble-server-cloud" # Template name in Proxmox
mediabox_storage = "local-lvm"
mediabox_storage_size = 100 # in GB
mediabox_cores = 4
mediabox_sockets = 1
mediabox_memory = 8192 # in MB
mediabox_ip_address = "192.168.1.102"
mediabox_bios = "seabios"
mediabox_machine_type = "q35"

# Nginx Proxy Manager Configuration
nginx_node = "proxmox-node"
nginx_vm_id = 103
nginx_hostname = "npm"
nginx_storage = "local-lvm"
nginx_storage_size = "8G"
nginx_cores = 2
nginx_memory = 1024
nginx_ip_address = "192.168.1.103"

# Ansible Playbook Paths
ansible_playbooks = {
  adguard = "../ansible/adguard.yml"
  tailscale = "../ansible/tailscale.yml"
  mediabox = "../ansible/mediabox.yml"
  nginx = "../ansible/nginx_proxy_manager.yml"
  proxmox = "../ansible/proxmox.yml"
}